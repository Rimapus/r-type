{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "J-Climb with the engine from ../younity-engine (Debug)",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "tests",
            "inherits": "default",
            "displayName": "J-Climb with the Criterion unit tests (Debug)",
            "cacheVariables": {
                "JCLIMB_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "release",
            "inherits": "default",
            "displayName": "J-Climb optimized build (Release)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default" },
        { "name": "tests", "configurePreset": "tests", "targets": ["tests_run"] },
        { "name": "release", "configurePreset": "release", "configuration": "Release" }
    ]
}
